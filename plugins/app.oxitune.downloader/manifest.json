{
  "id": "app.oxitune.downloader",
  "name": "Downloader",
  "version": "1.1.1",
  "apiVersion": 1,
  "description": "Adds a button to the player bar that saves the current song to your music folder with yt-dlp; Oxitune can install yt-dlp and ffmpeg for you.",
  "author": "Oxitune",
  "homepage": "https://github.com/7moons/oxitune-plugins",
  "matches": ["https://music.youtube.com/*"],
  "runAt": "document-idle",
  "permissions": ["player:read", "page", "ui", "media:save"],
  "hosts": [],
  "entry": "main.js",
  "styles": ["style.css"],
  "settings": [
    {
      "key": "format",
      "type": "select",
      "label": { "en": "Format", "pl": "Format" },
      "description": { "en": "MP3 gets the cover art embedded.", "pl": "W MP3 zapisywana jest też okładka." },
      "default": "mp3",
      "options": [
        { "value": "mp3", "label": "MP3" },
        { "value": "m4a", "label": "M4A (AAC)" },
        { "value": "opus", "label": "Opus" },
        { "value": "flac", "label": "FLAC" }
      ]
    }
  ]
}
